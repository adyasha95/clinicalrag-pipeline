# Copy this file to .env and fill in real values. Never commit .env.

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI (used for text-embedding-3-small)
OPENAI_API_KEY=your-openai-api-key-here

# Pinecone
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=clinicalrag
PINECONE_ENVIRONMENT=us-east-1-aws

# LangSmith (optional — enables tracing at smith.langchain.com)
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=clinicalrag

# ClinicalTrials.gov
CLINICALTRIALS_API_BASE_URL=https://clinicaltrials.gov/api/v2
